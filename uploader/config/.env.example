# -------------------------------------------------------
# Copy this file to config/.env and fill in your values.
# NEVER commit the real .env to version control.
# -------------------------------------------------------

# Path to your Google service account JSON key file
GOOGLE_CREDENTIALS_PATH=config/google-credentials.json

# SoundCloud OAuth credentials
# Register an app at https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret
SOUNDCLOUD_REFRESH_TOKEN=your_soundcloud_refresh_token

# Optional for first-time Authorization Code + PKCE exchange.
# If you set these, the uploader can exchange the one-time code for a user token.
SOUNDCLOUD_AUTHORIZATION_CODE=
SOUNDCLOUD_CODE_VERIFIER=
SOUNDCLOUD_REDIRECT_URI=

# Optional pre-fetched access token. Useful for short-lived manual testing only.
SOUNDCLOUD_ACCESS_TOKEN=

# SMTP credentials for error alert emails
SMTP_USERNAME=alerts@yourstation.com
SMTP_PASSWORD=your_smtp_app_password
